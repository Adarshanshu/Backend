<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>all post page</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
    <h1>Quora</h1>
    <div>
    <% for(let post of posts) { %>
        <div class="container">
            <a href="http://localhost:8080/posts/<%=post.id %>">see in detail</a>
        <h2>@<%= post.username %></h2>
        <h3><%=post.content %></h3>
        </div>
        <% } %>
        </div>
        <a href="http://localhost:8080/posts/new">create new Posts</a>
</body>
</html>