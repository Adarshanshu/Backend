<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1 class="heading">Quora Posts</h1>
    <% for(let post of posts) { %>
    <div class="post">
        <h2>@<%= post.username  %></h2>
        <h3><%= post.content  %></h3>
        <br>
        <button><a href="http://localhost:8080/post/<%=post.id  %>">see in detail</a></button>
         <button class="edit"><a href="http://localhost:8080/post/<%=post.id  %>/edit">Edit post</a></button>
          <form method="post" action="/post/<%= post.id %>?_method=DELETE">
            <button class="delete">Delete post</button>
          </form>
         
    </div>
    <% } %>

    <br><br>
   <button class="new"> <a href="http://localhost:8080/post/new">Create New Post</a></button>
</body>
</html>