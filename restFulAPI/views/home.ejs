<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quora Clone - Home</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f9f9f9;
      margin: 0;
      padding: 0;
    }

    header {
      background-color: #b92b27;
      color: white;
      padding: 15px;
      text-align: center;
    }

    nav {
      background-color: #fff;
      padding: 10px;
      text-align: center;
      border-bottom: 1px solid #ddd;
    }

    nav a {
      text-decoration: none;
      color: #b92b27;
      font-weight: bold;
      margin: 0 15px;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      max-width: 800px;
      margin: 20px auto;
      padding: 20px;
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      text-align: center;
    }

    .container h2 {
      color: #333;
    }

    .container p {
      color: #555;
    }
  </style>
</head>
<body>
  <header>
    <h1>Quora Clone</h1>
  </header>

  <nav>
    <a href="/">Home</a>
    <a href="http://localhost:8080/post">Posts</a>
  </nav>

  <div class="container">
    <h2>Welcome to Quora Clone</h2>
    <p>This is the root page. Use the navigation above to explore posts.</p>
  </div>
</body>
</html>
