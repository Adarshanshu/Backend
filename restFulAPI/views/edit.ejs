<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>Edit your post</h2>
    <p>post id : <%= post.id  %></p>
    <p>post username : <%= post.username %></p>
    <form class="post" method="post" action="/post/<%= post.id %>?_method=PATCH">
        <textarea rows="10" column="10" name="content"><%= post.content  %></textarea>
        <br> <br>
        <button>Submit</button>
    </form>
</body>
</html>