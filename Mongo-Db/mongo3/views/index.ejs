<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        .box{
            border:2px solid black;
            border-radius:5px;
            padding:5px;
            margin:10px;
            background-color:darkcyan;
            display:inline-block
        }
    </style>
</head>
<body>

   <a href="http://localhost:8080/chats/new"><button>create new chat</button></a>
   <br><br>
    <% for(chat of chats) {%>
        <div class="box">
            <h1>From : <%= chat.from %></h1>
            <h2> To : <%= chat.to %></h2>
            <h3> msg : <%= chat.msg %></h3>
            <h3> time : <%= chat.created_at.toString().split(" ").splice(0,5).join("-") %></h3>
            <form method="GET" action="/chats/<%=chat._id%>/edit">
                <button>Edit</button> <br><br>
            </form>
            <form method="POST" action="/chats/<%=chat._id%>?_method=DELETE">
                <button>Delete</button>
            </form>
        </div>
        <% } %>
</body>
</html>