<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slect car</title>
</head>
<style>
    body {
  background-image: url("https://images.unsplash.com/photo-1729575846511-f499d2e17d79?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8YmFja2dyb3VuZCUyMGltYWdlJTIwZm9yJTIwd2Vic2l0ZXxlbnwwfHwwfHx8MA%3D%3D"); /* replace with your image link */
  background-size: cover;       /* makes the image cover the entire viewport */
  background-repeat: no-repeat; /* prevents tiling */
  background-attachment: fixed; /* keeps the image fixed when scrolling */
  background-position: center;  /* centers the image */
  margin: 0;                    /* removes default margin */
  padding: 0;
}

    h1 ,h3{
        text-align:center;
        color:brown;

    }
     a{
            text-decoration:none;
        }
        button{
            background-color:wheat;
            box-shadow:5px 5px 10px grey;
            margin-left:680px;
            padding:10px;
        }
   
</style>
<body>
    <h1>Select random Car to drive today</h1>
   <button> <a href="/">Home ↩</a></button>
    <br>
    <br> <br>
    <h3>you should use today car No.</h3>
    <h1 id="car"><%= Math.floor( Math.random()*10 +1) %></h1>
    <button onClick="randomCar()">select Another car</button>
    <script>
        function randomCar(){
            let random = Math.floor(Math.random()*10 +1);
            document.getElementById("car").innerText = random;
        }
    </script>
</body>
</html>