<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>detail view of posts</title>
</head>
<body>
    <h3>details of the post are</h3>
    <div>
        <p>post Id : <%= post.id %></p>
        <h1>username : <%= post.username %></h1>
        <img src="<%= post.content %>" alt="image">
        <p>post description : <%= post.description %></p>
    </div>
    
</body>
</html>