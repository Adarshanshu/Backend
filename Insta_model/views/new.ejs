<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>post Something</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>write you own post</h1>
    <div>
        <form method="post" action="/post">
            <input type="text" name="username" placeholder="enter username" required><br><br>
            <input type="text" name="content" placeholder="enter the image url" required><br><br>
           <textarea name="description" placeholder="write something about you...."></textarea><br><br>
            <button>Submit</button>
        </form>
    </div>
</body>
</html>